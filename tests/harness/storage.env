SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SERVER_ADMIN_PORT=5001
SERVER_REGION=local
TENANT_ID=stub
REGION=local
GLOBAL_S3_BUCKET=stub
AUTH_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
AUTH_JWT_ALGORITHM=HS256
DATABASE_URL=postgresql://supabase_storage_admin:postgres@127.0.0.1:54322/postgres
DB_INSTALL_ROLES=false
DB_ANON_ROLE=anon
DB_SERVICE_ROLE=service_role
DB_AUTHENTICATED_ROLE=authenticated
DB_SUPER_USER=supabase_storage_admin
STORAGE_BACKEND=file
STORAGE_FILE_BACKEND_PATH=./storage-data
FILE_STORAGE_BACKEND_PATH=./storage-data
FILE_SIZE_LIMIT=52428800
UPLOAD_FILE_SIZE_LIMIT=52428800
UPLOAD_FILE_SIZE_LIMIT_STANDARD=52428800
IMAGE_TRANSFORMATION_ENABLED=false
RATE_LIMITER_ENABLED=false
PG_QUEUE_ENABLE=false
LOG_LEVEL=warn
DATABASE_SEARCH_PATH=storage,public,extensions
OTEL_METRICS_ENABLED=false
PROMETHEUS_METRICS_ENABLED=false
LOGFLARE_ENABLED=false
MULTI_TENANT=false
REQUEST_ALLOW_X_FORWARDED_PATH=true
