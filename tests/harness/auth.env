GOTRUE_API_HOST=127.0.0.1
PORT=9999
API_EXTERNAL_URL=http://127.0.0.1:54321/auth/v1
GOTRUE_SITE_URL=http://127.0.0.1:4173
GOTRUE_URI_ALLOW_LIST=http://127.0.0.1:4173/**
GOTRUE_DB_DRIVER=postgres
DATABASE_URL=postgres://supabase_auth_admin:postgres@127.0.0.1:54322/postgres?sslmode=disable
GOTRUE_DB_MIGRATIONS_PATH=./bin/migrations
GOTRUE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_LOG_LEVEL=warn
GOTRUE_RATE_LIMIT_HEADER=
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
