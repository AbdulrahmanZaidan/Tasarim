(instances (project "ta8" (path "/eaeb4ec9-7aba-57f2-802b-5a7062af6ec9/f21c6416-7a10-5cc4-ae6a-9383477ab628" (reference "#PWR0191") (unit 1)))))
(text "U401 (74HC161): F (5.1): 4-bit register olarak 161, /PE = NOT FL (U211), CEP = CET = 0, /MR =\n    /RESET_s → 0000. Q0..3 = Z C N V (uROM A12–15). TC boş.\nU402 (74HC377): A (5.1): D = R, /E = /DD_A. Reset yok (açılışta belirsiz).\nU403 (74HC377): IR (5.1): D = DB, /E = /DD_IR. Reset yok (0. adım her IR için FETCH).\nU404 (74HC245): A → DB (#DS Y2).\nU405 (74HC245): PCL → DB (#DS Y3).\nU406 (74HC245): PCH → DB (#DS Y4).\nU407 (SST39SF010): ALU-L (5.2): A0–3 = A[3:0], A4–7 = DB[3:0], A8 = C, A9 = A4, A10–14 = ALUOP,\n    A15 = A7, A16 = tablo jumper'ı (GND). D0–3 = R0–3, D4 = c4, D5 = Zlo, D6 = Clo, D7 boş. Hep\n    etkin. -70.\nU408 (SST39SF010): ALU-H (5.2): A0–3 = A[7:4], A4–7 = DB[7:4], A8 = c4, A9 = Zlo, A10 = Z,\n    A11–15 = ALUOP, A16 = GND. D0–3 = R4–7, D4 = Z, D5 = Chi, D6 = N, D7 = V. -70.\n\nPull dirençleri (10k): DB0↓, DB1↓, DB2↓, DB3↓, DB4↓, DB5↓, DB6↓, DB7↓" (exclude_from_sim no) (at 209.55 30.48 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "e8106cc1-b26e-5d71-b6ca-5679d0b517a2"))
)
