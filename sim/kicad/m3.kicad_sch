(instances (project "ta8" (path "/eaeb4ec9-7aba-57f2-802b-5a7062af6ec9/8b7200fa-2940-5aa0-9b52-cca8202e840b" (reference "#PWR0162") (unit 1)))))
(text "U301 (74HC161): PC bit 0–3. PC (5.1): /PE = /PCLD, P = AR (PCIN, 16 bit birden), CEP = PCINC,\n    /MR = /RESET_s → 0000. CET zinciri: CET = VCC (planda yalnız 'CET chained from TC'; ilk\n    kademe VCC seçildi).\nU302 (74HC161): PC bit 4–7. PC (5.1): /PE = /PCLD, P = AR (PCIN, 16 bit birden), CEP = PCINC,\n    /MR = /RESET_s → 0000. CET zinciri: CET = önceki kademenin TC'si.\nU303 (74HC161): PC bit 8–11. PC (5.1): /PE = /PCLD, P = AR (PCIN, 16 bit birden), CEP = PCINC,\n    /MR = /RESET_s → 0000. CET zinciri: CET = önceki kademenin TC'si.\nU304 (74HC161): PC bit 12–15. PC (5.1): /PE = /PCLD, P = AR (PCIN, 16 bit birden), CEP = PCINC,\n    /MR = /RESET_s → 0000. CET zinciri: CET = önceki kademenin TC'si. TC boş.\nU305 (74HC161): AR bit 0–3. AR (5.1): P = DB, alt çift /DD_ARL, üst çift /DD_ARH, CEP = ARINC.\n    Çıkışlar = PCIN. CET zinciri: CET = VCC (planda yalnız 'CET chained from TC'; ilk kademe\n    VCC seçildi).\nU306 (74HC161): AR bit 4–7. AR (5.1): P = DB, alt çift /DD_ARL, üst çift /DD_ARH, CEP = ARINC.\n    Çıkışlar = PCIN. CET zinciri: CET = önceki kademenin TC'si.\nU307 (74HC161): AR bit 8–11. AR (5.1): P = DB, alt çift /DD_ARL, üst çift /DD_ARH, CEP = ARINC.\n    Çıkışlar = PCIN. CET zinciri: CET = önceki kademenin TC'si.\nU308 (74HC161): AR bit 12–15. AR (5.1): P = DB, alt çift /DD_ARL, üst çift /DD_ARH, CEP =\n    ARINC. Çıkışlar = PCIN. CET zinciri: CET = önceki kademenin TC'si. TC boş.\nU309 (74HC161): X bit 0–3. X (5.1): P = DB, /DD_XL, /DD_XH, CEP = XINC. CET zinciri: CET = VCC\n    (planda yalnız 'CET chained from TC'; ilk kademe VCC seçildi).\nU310 (74HC161): X bit 4–7. X (5.1): P = DB, /DD_XL, /DD_XH, CEP = XINC. CET zinciri: CET =\n    önceki kademenin TC'si.\nU311 (74HC161): X bit 8–11. X (5.1): P = DB, /DD_XL, /DD_XH, CEP = XINC. CET zinciri: CET =\n    önceki kademenin TC'si.\nU312 (74HC161): X bit 12–15. X (5.1): P = DB, /DD_XL, /DD_XH, CEP = XINC. CET zinciri: CET =\n    önceki kademenin TC'si. TC boş.\nU313 (74HC191): SP alt nibble (5.1): /CE = NOT SPCNT (U211), D/U = SPDN (1 = aşağı), D = 1111,\n    /PL = /RESET_s → F. MAX/MIN → üst /CE NAND'ı (U501). /RC boş.\nU314 (74HC191): SP üst nibble: /CE = NAND(SPCNT, MAX/MIN_alt) (U501). MAX/MIN ve /RC boş.\nU315 (74HC245): AB tamponu: PC alt → AB0–7. DIR = VCC (A→B), /OE = /AB_PC (#AS).\nU316 (74HC245): AB tamponu: PC üst → AB8–15. DIR = VCC (A→B), /OE = /AB_PC (#AS).\nU317 (74HC245): AB tamponu: AR alt → AB0–7. DIR = VCC (A→B), /OE = /AB_AR (#AS).\nU318 (74HC245): AB tamponu: AR üst → AB8–15. DIR = VCC (A→B), /OE = /AB_AR (#AS).\nU319 (74HC245): AB tamponu: X alt → AB0–7. DIR = VCC (A→B), /OE = /AB_X (#AS).\nU320 (74HC245): AB tamponu: X üst → AB8–15. DIR = VCC (A→B), /OE = /AB_X (#AS).\nU321 (74HC245): AB tamponu: SP → AB0–7. DIR = VCC (A→B), /OE = /AB_SP (#AS).\nU322 (74HC245): AB tamponu: EF sabiti → AB8–15 (A girişleri EF = 1110 1111'e bağlı). DIR = VCC\n    (A→B), /OE = /AB_SP (#AS).\n\nPull dirençleri (10k): AB0↑, AB1↑, AB10↑, AB11↑, AB12↑, AB13↑, AB14↑, AB15↑, AB2↑, AB3↑, AB4↑,\n    AB5↑, AB6↑, AB7↑, AB8↑, AB9↑, DB0↓, DB1↓, DB2↓, DB3↓, DB4↓, DB5↓, DB6↓, DB7↓" (exclude_from_sim no) (at 231.14 30.48 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "2aceba6f-6204-583d-a135-33d04e1aeb78"))
)
