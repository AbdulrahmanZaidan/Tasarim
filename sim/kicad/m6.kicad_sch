(instances (project "ta8" (path "/eaeb4ec9-7aba-57f2-802b-5a7062af6ec9/3f2fbfa8-3779-5347-9d17-6aadd0273979" (reference "#PWR0295") (unit 1)))))
(text "U701 (74HC74): FF1: 25 MHz ÷ 2 → DCLK 12.5 MHz (8.1). FF2: LD flip-flop'u, D = NAND4(Q2, Q1,\n    Q0, 1); LD = /Q yalnız noktanın 0. periyodunda 1, CCLK = Q = /LD.\nU702 (74HC163): Nokta sayacı (8.1): DCLK ile sayar; karakter = 8 nokta (Q0–Q2, mod 8). Q3\n    kullanılmaz.\nU703 (74HC20): LD_D = NAND4(DOT2, DOT1, DOT0, 1): nokta 7'de 0. 2. kapı boş.\nU704 (74HC163): HCHAR alt 4 bit (8.2). /MR senkron temizleme = /HEND (ROM D4): H = 49'dan sonra\n    0.\nU705 (74HC163): HCHAR üst 2 bit (H4, H5); Q2, Q3 kullanılmaz.\nU706 (74HC04): HEND = NOT /HEND: VLINE satır sonunda bir artar. 2–6. kapı boş.\nU707 (74HC163): VLINE bit 0–3 (8.2): yalnız HEND = 1 iken (satır sonu) sayar. /MR = /VEND (ROM\n    D5).\nU708 (74HC163): VLINE bit 4–7.\nU709 (74HC163): VLINE bit 8–9; Q2, Q3 kullanılmaz.\nU710 (SST39SF010): Zamanlama ROM'u (8.2): A0–5 = H, A6–15 = V, A16 = SLOW. İçerik\n    ta8.vga.timing_rom().\nU711 (74HC377): T1 registerı (8.2): /E = /LD = CCLK, CP = DCLK; ROM çıkışlarını karakter\n    sınırında yakalar, böylece sync/blank kayan glyph ile aynı hizada çıkar (8.3). Q7 = VWR →\n    M1 U111 senkronlayıcısı → VWR_s.\n\nDışarıdan (buton/anahtar/osilatör/taklit) sürülenler: OSC25, SLOW" (exclude_from_sim no) (at 158.75 30.48 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "f805292c-4a5d-5f33-9f5c-66bba6a3d045"))
)
