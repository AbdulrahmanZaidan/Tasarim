(instances (project "ta8" (path "/eaeb4ec9-7aba-57f2-802b-5a7062af6ec9/3be54d99-82ad-5bca-9be4-fff48eb2f2e2" (reference "#PWR0220") (unit 1)))))
(text "U601 (SST39SF010): Program ROM (7.1): A0–14 = AB, A15/A16 = bank jumper'ları (GND: bank 0), /CE\n    = A15 (doğrudan kablo), /OE = /RD, /WE = VCC. -90 (DOGRULAMA 2b: -90 eski stok program\n    ROM'una).\nU602 (CY62256): RAM CY62256-70 (7.1): 8000–EFFF. /CE = NAND(A15, /FPAGE) (U501), /OE = /RD, /WE\n    = /WR.\nU603 (74HC20): /FPAGE = NAND4(A15..A12) (7.2). 2. kapı boş (girişleri GND).\nU604 (74HC138): #IOR (7.2): A0..A2, G1 = VCC (ISA-v0-sentez 6.1), /G2A = /IOSEL, /G2B = /RD. Y0\n    /KBD_RD (F800), Y1 /STAT_RD (F801), Y2–Y7 ayrılmış (boş).\nU605 (74HC377): LED portu (7.3): /E = OR(/IOSEL, /MEMW) commit'te örneklenir, CP = CLK (LED\n    dalı). F800–FFFF'e her yazma buraya.\nU606 (74HC245): KSTAT (7.3): b7 = KRDY, b6 = VWR_s, b5..b0 = DIP SW5..SW0 → DB, /OE = /STAT_RD.\n    DIP: anahtar + pull-up/down (burada test tezgâhı girişi).\n\nPull dirençleri (10k): AB0↑, AB1↑, AB10↑, AB11↑, AB12↑, AB13↑, AB14↑, AB15↑, AB2↑, AB3↑, AB4↑,\n    AB5↑, AB6↑, AB7↑, AB8↑, AB9↑, DB0↓, DB1↓, DB2↓, DB3↓, DB4↓, DB5↓, DB6↓, DB7↓\n\nDışarıdan (buton/anahtar/osilatör/taklit) sürülenler: DIP0, DIP1, DIP2, DIP3, DIP4, DIP5, KRDY" (exclude_from_sim no) (at 149.86 30.48 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "f64032e1-f51e-5009-a207-93c21e484abb"))
)
