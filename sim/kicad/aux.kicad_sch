(instances (project "ta8" (path "/eaeb4ec9-7aba-57f2-802b-5a7062af6ec9/bc1b966c-d9fa-5027-a679-ec1270400b13" (reference "#PWR0201") (unit 1)))))
(text "U501 (74HC00): SP üst /CE = NAND(SPCNT, MAX/MIN_alt) (5.1); RAM /CE = NAND(A15, /FPAGE) (7.2);\n    /MWR = NAND(MEMW_L, WSTB) (7.2). 4. kapı boş.\nU502 (74HC08): /RD = AND(/MRD, /ARD_RD), /WR = AND(/MWR, /ARD_WR) (2). 3. kapı /ACCESS =\n    AND(/MRD, /MEMW): bu çevrim belleği okuyor ya da yazıyor (breakpoint, 10). 4. boş.\nU503 (74HC32): C = OR(Clo, Chi) (5.2); /LED_E = OR(/IOSEL, /MEMW) (7.2); VRAM /WE = OR(/WR,\n    /VRAMSEL) (7.2; VRAM M6'da, burada taklit X1); STOP'un son OR'u BRQ_s | (…) (3.3).\n\nPull dirençleri (10k): /ARD_RD↑, /ARD_WR↑, AB15↑" (exclude_from_sim no) (at 88.9 30.48 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "93f97455-aea3-5537-9397-477fb5e64045"))
)
