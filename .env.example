# Supabase bağlantısı — Supabase panelinde: Project Settings → API
# Yalnızca "anon" (publishable) anahtarını kullanın. service_role / secret anahtarı ASLA buraya yazmayın.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# İsteğe bağlı: Supabase görüntü dönüştürme (Pro plan). Boş bırakılırsa özgün görseller kullanılır.
VITE_SUPABASE_IMAGE_TRANSFORM=
